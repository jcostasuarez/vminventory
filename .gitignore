# =============================================================================
# VM Inventory - .gitignore
# =============================================================================

# --- Artefactos de Compilación & Frontend ---
dist/
dist-ssr/
build/
target/
src-tauri/target/
node_modules/
.pnp
.pnp.js
coverage/
*.local
*.spec

# --- Rust, Cargo & Compilados Binarios ---
**/*.rs.bk
*.pdb
*.exe
*.msi
*.dll
*.dylib
*.so

# --- Entornos Virtuales & Python ---
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc

# --- Tauri Generated ---
src-tauri/gen/schemas/
src-tauri/gen/

# --- Bases de Datos Temporales & Salidas ---
*.db
*.sqlite
*.sqlite3
relevamiento_*.json
resultado_*.json
informe_*.json

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Logs & Runtime ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & IDE Directories ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosv
*.sln.docstates
*.swp
*.swo
*~

# --- Carpetas y Archivos del Sistema Operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
